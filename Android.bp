// Minimal stub of the LineageOS platform java modules (packages/lineage)
// missing from the CLO/AOSPA base, needed by hardware/samsung apps + FlipFlap.

java_library {
    name: "org.lineageos.platform.internal",
    srcs: ["java/**/*.java"],
}

android_library {
    name: "org.lineageos.settings.resources",
    use_resource_processor: true,
    manifest: "settings-res/AndroidManifest.xml",
    resource_dirs: ["settings-res/res"],
}

cc_library_headers {
    name: "display_intf_headers",
    export_include_dirs: ["../hardware/qcom-caf/sm8650/display/include"],
}

cc_library_shared {
    name: "vendor.qti.hardware.display.config-V16-ndk",
}
